# URL de connexion PostgreSQL (Railway la fournit automatiquement dans les variables du service)
DATABASE_URL=postgresql://user:password@host:port/database

# Clé secrète pour signer les cookies de session (change-la avant le déploiement)
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Port (Railway le définit automatiquement, 3000 en local)
PORT=3000

# Environnement
NODE_ENV=production

# Token du bot Discord (notifications par DM aux joueurs). Optionnel : si absent, les
# notifications Discord sont simplement désactivées (aucun impact sur le reste du site).
# Le bot doit être invité sur un serveur Discord où se trouvent les joueurs pour pouvoir
# leur envoyer un message privé.
DISCORD_BOT_TOKEN=
